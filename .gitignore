# PSM-WMA 仓库忽略策略(G0 监督者 P4,2026-08-15 Kimi 补建)
# 原则:Gate 机器可判证据(JSON/JSONL/报告/小日志)入库;大体积中间产物忽略。

__pycache__/
*.pyc

# DCP 训练 checkpoint(单个 ~12GB)
artifacts/**/checkpoints/

# 预览视频
artifacts/**/*.mp4

# 仿真支持包与 GIF 预览
.r06_sim_pkgs/
artifacts/**/*.gif
artifacts/**/train.log

# Workspace hygiene (PSM-WMA_workspace_hygiene_plan_v0.1.md, 2026-09-17)
# 只抑制 git status 噪声，不删除任何文件。

# authority-root materialization worktree（未来落到项目外 scratch root）
.authority-root-materialization-*/
.authority-root.index

# runtime/evidence 产物（保留磁盘，不入库）
artifacts/g0/latent_cache_route_probe/
artifacts/g0/active_soak45/
artifacts/g0/d8a_memcheck/
artifacts/g0/resume_control/
artifacts/g0/resume_smoke/

# 一次性临时/遗留文件
tmp_escape_link.json
tmp_escape_target.json
SESSION_HANDOFF_*.md
.local/
outputs/
results/

# A2 process records are intentionally versioned: launch receipts, YAML configs,
# metrics, logs, exit codes, JUnit and verifier reports. Heavy binary payloads are not.
artifacts/**/config.pkl
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.safetensors
artifacts/**/*.ckpt
artifacts/**/*.distcp

# Superseded verifier snapshots; keep only the final v3 verifier in Git.
artifacts/g0/sync_a2_final_verification_2a9df880.json
artifacts/g0/sync_a2_final_verification_2a9df880_v2.json
