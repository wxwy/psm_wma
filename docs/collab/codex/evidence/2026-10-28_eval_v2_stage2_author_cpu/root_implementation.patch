+@pytest.mark.parametrize("failure", [False, True])
+def test_media_preserves_already_loaded_torch_cpu_rng_without_cuda(failure):
+    import torch
+
+    torch.manual_seed(41)
+    before = torch.get_rng_state().clone()
+
+    def writer():
+        torch.rand(8)
