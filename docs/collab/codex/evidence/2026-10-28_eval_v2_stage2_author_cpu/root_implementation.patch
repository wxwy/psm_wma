+    channel, thread, errors, env = run_worker(conf, monkeypatch)
+    try:
+        assert receive(channel)["kind"] == "FATAL"
+    finally:
+        channel.close()
+        thread.join(2)
+    assert errors and "source mismatch" in str(errors[0]) and env.resets == 0
+
