+                # process died. Actual encoder/feeder liveness is checked later.
+                self.failed = self.failed or error.errno != errno.EBADF
+                _diagnostic(self.errors, error)
+            except Exception as error:
+                self.failed = True
+                _diagnostic(self.errors, error)
+            finally:
+                self.done = True
+        finally:
+            self.lock.release()
