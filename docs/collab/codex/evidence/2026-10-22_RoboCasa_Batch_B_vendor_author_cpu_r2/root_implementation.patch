+        package = ModuleType(name)
+        package.__file__ = str(checkout / "robosuite" / name.replace(".", "/") / "__init__.py")
+        package.__path__ = [str(Path(package.__file__).parent)]
+        monkeypatch.setitem(sys.modules, name, package)
