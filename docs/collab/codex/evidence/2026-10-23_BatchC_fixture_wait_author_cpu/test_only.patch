+COMPLETION_WAIT_S = 120.0
+LATE_SCENARIO_WATCHDOG_S = COMPLETION_WAIT_S + 60.0
+SCENARIO_CLEANUP_RESERVE_S = 30.0
+SLOW_HEALTHY_DELAY_S = 13.0
+LATE_COMPLETION_CASES = {
