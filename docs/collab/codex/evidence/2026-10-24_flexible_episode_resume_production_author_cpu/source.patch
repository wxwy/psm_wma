+"""Read-only recovery of logical reservations; not production scheduling or writes."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import os
+import re
+import stat
+from pathlib import Path
+
+from . import MAX_RECOVERY_BYTES, bounded_episode_count, bounded_episode_index, bounded_records
+
+_SHA = re.compile(r"[0-9a-f]{64}\Z")
+
+
+class ReservationRecoveryError(ValueError):
+    """Ambiguous/untrusted recovery input must not become a new higher slot."""
+
+    def __init__(self, code, message):
+        super().__init__(f"{code}: {message}")
+        self.code = code
+
+
+def _fail(code, message):
+    raise ReservationRecoveryError(code, message)
+
+
+def _slot(value):
+    try:
+        return bounded_episode_index(value)
+    except ValueError as error:
+        _fail("INVALID_LOGICAL_SLOT", str(error))
+
+
+def _source(reference):
+    if not isinstance(reference, dict) or not isinstance(reference.get("path"), str):
+        _fail("RECOVERY_SOURCE_MISSING", "persistent input needs a source_ref with a path and hash/digest")
+    if not Path(reference["path"]).is_absolute():
+        _fail("RECOVERY_SOURCE_INVALID", "persistent source path must be absolute")
+    hashes = [reference[name] for name in ("sha256", "original_digest") if name in reference]
+    if not hashes or any(not isinstance(value, str) or not _SHA.fullmatch(value) for value in hashes):
+        _fail("RECOVERY_SOURCE_INVALID", "persistent source needs a valid SHA256 or original identity digest")
+    return copy.deepcopy(reference)
+
+
+def _references(row):
+    references = [_source(row.get("source_ref"))]
+    if "recovery_document_source_ref" in row:
+        references.append(_source(row["recovery_document_source_ref"]))
+    for reference in bounded_records(row.get("progress_source_refs", ()), "progress source references"):
+        references.append(_source(reference))
+    return references
+
+
+def _unique(references):
+    by_json = {json.dumps(row, sort_keys=True, ensure_ascii=False, allow_nan=False): row for row in references}
+    return [copy.deepcopy(by_json[key]) for key in sorted(by_json)]
+
+
+def _pairs(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            _fail("RECOVERY_DOCUMENT_INVALID", f"duplicate JSON key: {key}")
+        result[key] = value
+    return result
+
+
+def _witness(value):
+    return value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns
+
+
+def read_recovery_document(path):
+    """Read a persisted catalog/progress projection and attach its byte witness.
+
+    The JSON object may contain completed_slots, reservations and/or
+    progress_diagnostics; no new schema/version discriminator is required.
+    Existing Episode source references are preserved, not relabeled as this
+    catalog. Persisted completed_slots ALSO become reservation observations,
+    never proof of completed Episode outcomes. This reader is not a substitute
+    for the original Episode validator.
+    """
+    path = Path(path).absolute()
+    try:
+        if any(parent.is_symlink() for parent in (path, *path.parents)):
+            _fail("RECOVERY_DOCUMENT_INVALID", "persistent recovery path must not contain symlinks")
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        with os.fdopen(fd, "rb") as stream:
+            before = os.fstat(stream.fileno())
+            if not stat.S_ISREG(before.st_mode):
+                _fail("RECOVERY_DOCUMENT_INVALID", "persistent recovery input must be an ordinary file")
+            if before.st_size > MAX_RECOVERY_BYTES:
+                _fail("RECOVERY_DOCUMENT_INVALID", "persistent recovery document exceeds 64 MiB")
+            raw = stream.read(MAX_RECOVERY_BYTES + 1)
+            if len(raw) > MAX_RECOVERY_BYTES:
+                _fail("RECOVERY_DOCUMENT_INVALID", "persistent recovery document grew beyond 64 MiB")
+            after = os.fstat(stream.fileno())
+        if _witness(before) != _witness(after) or _witness(after) != _witness(path.stat(follow_symlinks=False)):
+            _fail("RECOVERY_DOCUMENT_CHANGED", str(path))
+        document = json.loads(
+            raw,
+            object_pairs_hook=_pairs,
+            parse_constant=lambda value: _fail("RECOVERY_DOCUMENT_INVALID", f"nonfinite JSON: {value}"),
+        )
+    except (OSError, UnicodeError, json.JSONDecodeError) as error:
+        raise ReservationRecoveryError("RECOVERY_DOCUMENT_INVALID", str(error)) from error
+    if not isinstance(document, dict):
+        _fail("RECOVERY_DOCUMENT_INVALID", "recovery document must be a JSON object")
+    reference = {"path": str(path), "sha256": hashlib.sha256(raw).hexdigest()}
+    result = {"source_ref": reference}
+    for kind in ("completed_slots", "reservations", "progress_diagnostics"):
+        rows = document.get(kind, [])
+        if not isinstance(rows, list):
+            _fail("RECOVERY_DOCUMENT_INVALID", f"{kind} must be a list")
+        output = []
+        for row in bounded_records(rows, kind):
+            if kind == "completed_slots" and type(row) is int:
+                row = {"logical_episode_index": row}
+            if not isinstance(row, dict):
+                _fail("RECOVERY_DOCUMENT_INVALID", f"{kind} row must be an object")
+            row = copy.deepcopy(row)
+            if "task" not in row and "task" in document:
+                row["task"] = document["task"]
+            row.setdefault("source_ref", copy.deepcopy(reference))
+            row["recovery_document_source_ref"] = copy.deepcopy(reference)
+            output.append(row)
+        result[kind] = output
+    result["reservations"] = result["completed_slots"] + result["reservations"]
+    return result
+
+
+def _mapping(row):
+    reference = row.get("source_ref", {})
+    attempt = row.get("attempt", reference.get("attempt"))
+    episode = row.get("source_episode", reference.get("source_episode"))
+    if episode is None and "episode" in row:
+        episode = row["episode"]
+    if attempt is None and episode is None:
+        return None
+    if not isinstance(attempt, str) or not attempt or episode is None:
+        _fail("RECOVERY_LOGICAL_MAPPING_MISSING", "physical Episode mapping needs attempt and source_episode")
+    episode = _slot(episode)
+    origin = row.get("original_digest", reference.get("original_digest", reference.get("run_dir", "")))
+    return str(origin), attempt, episode
+
+
+def recover_pending_slots(*, task, completed_slots, reservations=(), progress_diagnostics=(), requested_episodes=None):
+    """Rebuild pending IDs from durable observations, independently of demand.
+
+    Completed records must come from the upstream Episode verifier. Their
+    source-bearing catalog observations are durable authority under the frozen
+    continuous logical-ID protocol, so a lost reservation file does not hide a
+    gap. Bare ints support pure algorithm tests only: no durable gap proof is
+    invented from them. Provenance remains evidence, not model identity.
+    """
+    if not isinstance(task, str) or not task.isidentifier() or task == "all":
+        _fail("INVALID_RECOVERY_TASK", repr(task))
+    if requested_episodes is not None:
+        try:
+            bounded_episode_count(requested_episodes, "requested_episodes")
+        except ValueError as error:
+            _fail("INVALID_RECOVERY_REQUEST", str(error))
+    completed, evidence, physical, explicit_ids, id_slots, sources = set(), {}, {}, {}, {}, []
+    diagnostics = []
+    bare_completed = []
+
+    def observe(row, slot, kind):
+        references = _references(row)
+        sources.extend(references)
+        evidence.setdefault(slot, []).extend(references)
+        mapping = _mapping(row)
+        if mapping is not None:
+            if mapping in physical and physical[mapping] != slot:
+                _fail("RECOVERY_MAPPING_CONFLICT", f"{mapping!r} maps to both {physical[mapping]} and {slot}")
+            physical[mapping] = slot
+        reservation_id = row.get("reservation_id")
+        if reservation_id is not None:
+            if not isinstance(reservation_id, str) or not reservation_id:
+                _fail("RECOVERY_RESERVATION_CONFLICT", "reservation_id must be a nonempty string when present")
+            if slot in explicit_ids and explicit_ids[slot] != reservation_id:
+                _fail("RECOVERY_RESERVATION_CONFLICT", f"logical slot {slot} has conflicting reservation IDs")
+            if reservation_id in id_slots and id_slots[reservation_id] != slot:
+                _fail("RECOVERY_RESERVATION_CONFLICT", f"reservation {reservation_id!r} maps to multiple slots")
+            explicit_ids[slot], id_slots[reservation_id] = reservation_id, slot
+        if kind == "completed":
+            completed.add(slot)
+
+    for row in bounded_records(completed_slots, "completed_slots"):
+        if type(row) is int:
+            completed.add(_slot(row))
+            bare_completed.append(row)
+            continue
+        if not isinstance(row, dict):
+            _fail("INVALID_COMPLETED_SLOT", "completed inputs must be verified history records or test integers")
+        if row.get("task", task) != task:
+            continue
+        value = row.get("logical_episode_index")
+        if value is None and row.get("sampling_protocol") == "legacy_task_stream":
+            value = row.get("source_episode")
+        observe(row, _slot(value), "completed")
+
+    for row in bounded_records(reservations, "reservations"):
+        if not isinstance(row, dict):
+            _fail("INVALID_RESERVATION", "reservation must be a source-bearing object")
+        if row.get("task", task) == task:
+            observe(row, _slot(row.get("logical_episode_index")), "reservation")
+
+    for row in bounded_records(progress_diagnostics, "progress_diagnostics"):
+        if not isinstance(row, dict):
+            _fail("INVALID_PROGRESS_DIAGNOSTIC", "progress observation must be a source-bearing object")
+        if row.get("task", task) != task:
+            continue
+        value = row.get("logical_episode_index")
+        if value is None:
+            mapping = _mapping(row)
+            if mapping not in physical:
+                _fail("RECOVERY_LOGICAL_MAPPING_MISSING", f"no persistent logical mapping for progress {mapping!r}")
+            value = physical[mapping]
+        observe(row, _slot(value), "progress")
+
+    known = completed | set(evidence)
+    maximum = max(known, default=-1)
+    # Large sparse inputs fail before materializing a range unless a persistent
+    # observation actually attests the continuous logical-ID namespace.
+    durable_maximum = max(evidence, default=-1)
+    if maximum > durable_maximum:
+        expected = 0
+        for value in sorted(known):
+            if value != expected and value > durable_maximum:
+                _fail("RECOVERY_AUTHORITY_MISSING", f"logical gap {expected} has no persistent authority")
+            expected = value + 1
+    pending = sorted(set(range(maximum + 1)) - completed)
+    references = _unique(sources)
+    for slot in pending:
+        if slot in evidence:
+            code = "RECOVERED_PENDING_FROM_PERSISTENT_RESERVATION_OR_PROGRESS"
+            slot_sources = _unique(evidence[slot])
+        elif evidence:
+            code = "INFERRED_FROM_PERSISTENT_COMPLETED_SLOT_GAP"
+            slot_sources = references
+        else:
+            _fail("RECOVERY_AUTHORITY_MISSING", f"logical gap {slot} has no persistent authority")
+        diagnostics.append({"code": code, "task": task, "logical_episode_index": slot, "source_refs": slot_sources})
+    if bare_completed:
+        diagnostics.append(
+            {"code": "BARE_COMPLETED_INTS_ARE_ALGORITHM_INPUT_NOT_PERSISTENT_PROOF", "slots": sorted(bare_completed)}
+        )
+    return {
+        "pending_slots": pending,
+        "next_slot_floor": maximum + 1,
+        "diagnostics": diagnostics,
+        "reservation_identities": {
+            str(slot): {
+                "stable_identity": {"task": task, "logical_episode_index": slot},
+                "reservation_id": explicit_ids.get(slot),
+                "pending": slot not in completed,
+            }
+            for slot in sorted(known | set(pending))
+        },
+        "authority": {
+            "protocol": "CONTINUOUS_LOGICAL_IDS_FROM_ZERO",
+            "source_refs": references,
+            "completed_slots": sorted(completed),
+            "observed_slots": sorted(known),
+            "requested_episodes": requested_episodes,
+            "pending_is_not_filtered_by_current_demand": True,
+            "observation_scope": "UPSTREAM_VERIFIED_EPISODES_AND_READONLY_PERSISTENT_MAPPING_OR_PROGRESS",
+        },
+    }
diff --git a/scripts/robocasa_episode_resume/scene_sampling.py b/scripts/robocasa_episode_resume/scene_sampling.py
new file mode 100644
index 00000000..03c55536
--- /dev/null
+++ b/scripts/robocasa_episode_resume/scene_sampling.py
@@ -0,0 +1,175 @@
+"""Scene execution plans. Never imports or launches a simulator.
+
+Fresh tasks retain the literal task seed and one environment's consecutive resets.
+Only true resume gaps use independent seeds when the historical RNG is unavailable.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+
+from . import bounded_episode_index, bounded_records
+
+SAMPLER_VERSION = "psm_robocasa_independent_episode_seed_v1"
+FRESH_SAMPLER_VERSION = "legacy_task_stream"
+
+
+def _integer(value, field):
+    if type(value) is not int or value < 0:
+        raise ValueError(f"{field} must be a nonnegative integer")
+    return value
+
+
+def _task(task):
+    if (
+        not isinstance(task, str)
+        or not task.strip()
+        or task != task.strip()
+        or task in {".", ".."}
+        or any(value in task for value in ("/", "\\", "\0"))
+    ):
+        raise ValueError("task must be one unambiguous underlying task name")
+
+
+def derive_episode_seed(*, requested_seed, task, logical_episode_index):
+    """Stable gap seed; nonce, execution order and GPU are absent."""
+    _integer(requested_seed, "requested_seed")
+    bounded_episode_index(logical_episode_index)
+    _task(task)
+    material = {
+        "sampler_version": SAMPLER_VERSION,
+        "requested_seed": requested_seed,
+        "task": task,
+        "logical_episode_index": logical_episode_index,
+    }
+    encoded = json.dumps(material, sort_keys=True, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode()
+    digest = hashlib.sha256(encoded).hexdigest()
+    return {
+        "requested_seed": requested_seed,
+        "seed_family": {"requested_seed": requested_seed, "sampler_version": SAMPLER_VERSION},
+        "effective_seed": int(digest[:8], 16),
+        "seed_material_sha256": digest,
+        "task": task,
+        "logical_episode_index": logical_episode_index,
+    }
+
+
+def plan_scene_sampling(*, task, requested_seed, new_logical_indices, attempt_nonce, sampling_mode, legacy_sources=()):
+    """Return a JSON plan only. Legacy sources are opaque, immutable references.
+
+    Caller supplies already-verified completed historical sources. Fresh mode
+    never derives a seed: one batch owns the literal seed and N public resets.
+    Gap mode maps each logical slot to a separate physical Episode0 attempt.
+    Neither path rewrites the original attempt-local Episode/C01 identity.
+    ``attempt_nonce`` records the new attempt but does not alter a slot's seed.
+    """
+    if not isinstance(attempt_nonce, str) or not attempt_nonce.strip() or len(attempt_nonce) > 256:
+        raise ValueError("attempt_nonce must be a nonempty bounded provenance string")
+    indices = bounded_records(new_logical_indices, "new logical indices")
+    for index in indices:
+        bounded_episode_index(index)
+    if len(indices) != len(set(indices)):
+        raise ValueError("duplicate new logical Episode indices")
+    # Validate seed/task even when no new episodes are needed. Do not change old
+    # UNKNOWN/None seeds to the newly requested seed or a guessed derived value.
+    _integer(requested_seed, "requested_seed")
+    _task(task)
+    preserved = copy.deepcopy(bounded_records(legacy_sources, "legacy sources"))
+    if not all(isinstance(source, dict) for source in preserved):
+        raise ValueError("legacy_sources must contain explicit source records")
+    json.dumps(preserved, ensure_ascii=False, allow_nan=False)
+    if sampling_mode not in {"fresh_task_stream", "resume_gap_independent"}:
+        raise ValueError("sampling_mode must explicitly select fresh_task_stream or resume_gap_independent")
+    fresh = sampling_mode == "fresh_task_stream"
+    if fresh and (preserved or sorted(indices) != list(range(len(indices)))):
+        raise ValueError("fresh task requires no completed historical sources and consecutive logical slots from zero")
+    if not fresh and not preserved:
+        raise ValueError("resume gap requires verified completed historical sources; use fresh mode for a new task")
+    episodes, batches = [], []
+    sampler = FRESH_SAMPLER_VERSION if fresh else SAMPLER_VERSION
+    for physical, index in enumerate(sorted(indices)):
+        identity = (
+            {
+                "requested_seed": requested_seed,
+                "seed_family": {"requested_seed": requested_seed, "sampler_version": sampler},
+                "effective_seed": requested_seed,
+                "seed_material_sha256": None,
+                "task": task,
+                "logical_episode_index": index,
+            }
+            if fresh
+            else derive_episode_seed(requested_seed=requested_seed, task=task, logical_episode_index=index)
+        )
+        source_episode = physical if fresh else 0
+        batch_index = 0 if fresh else physical
+        episode = {
+            **identity,
+            "attempt_nonce": attempt_nonce,
+            "sampling_mode": sampling_mode,
+            "source_episode": source_episode,
+            "execution_batch": batch_index,
+            "reset_plan": {
+                "environment_lifecycle": "shared_task_environment_continuous_resets"
+                if fresh
+                else "fresh_environment_per_new_episode",
+                "constructor_seed_argument": "effective_seed",
+                "public_reset_calls": 1,
+                "public_reset_ordinal": source_episode,
+                "source_episode": source_episode,
+                "constructor_rng_draws": "UNOBSERVED",
+                "local_memory": "fresh_episode_session_begin_end",
+                "historical_rng_state_restored": False,
+            },
+        }
+        episodes.append(episode)
+        if not fresh or not batches:
+            batches.append(
+                {
+                    "batch_index": batch_index,
+                    "sampling_mode": sampling_mode,
+                    "effective_seed": episode["effective_seed"],
+                    "environment_constructions": 1,
+                    "public_reset_calls": 0,
+                    "episodes": [],
+                }
+            )
+        batches[batch_index]["episodes"].append({"logical_episode_index": index, "source_episode": source_episode})
+        batches[batch_index]["public_reset_calls"] += 1
+    warnings = (
+        []
+        if fresh
+        else [
+            "DERIVED_ENVIRONMENT_SEED_IS_NOT_THE_REQUESTED_BASE_SEED",
+            "NOT_HISTORICAL_RNG_STREAM_CONTINUATION",
+            "DISTINCT_PHYSICAL_SCENES_NOT_GUARANTEED",
+        ]
+    )
+    seen = {}
+    for episode in () if fresh else episodes:
+        previous = seen.setdefault(episode["effective_seed"], episode["logical_episode_index"])
+        if previous != episode["logical_episode_index"]:
+            warnings.append("UINT32_DERIVED_SEED_COLLISION")
+    known_legacy_seeds = {
+        source["effective_seed"]
+        for source in preserved
+        if type(source.get("effective_seed")) is int and source["effective_seed"] >= 0
+    }
+    if known_legacy_seeds & set(seen):
+        warnings.append("DERIVED_SEED_MATCHES_A_KNOWN_LEGACY_ENVIRONMENT_SEED")
+    return {
+        "schema": "psm_episode_resume_scene_plan_v1",
+        "production_wired": True,
+        "sampler_version": sampler,
+        "sampling_mode": sampling_mode,
+        "task": task,
+        "requested_seed": requested_seed,
+        "legacy_sources": preserved,
+        "new_episodes": episodes,
+        "execution_batches": batches,
+        "warnings": list(dict.fromkeys(warnings)),
+        "benchmark_qualification": "UNCHANGED_TASK_LITERAL_SEED_SEQUENTIAL_RESET_PROTOCOL"
+        if fresh
+        else "Independent-scene convenience plan; not a continuous legacy/base-seed benchmark",
+    }
diff --git a/scripts/robocasa_resume_cli.py b/scripts/robocasa_resume_cli.py
new file mode 100644
index 00000000..867a3f69
--- /dev/null
+++ b/scripts/robocasa_resume_cli.py
@@ -0,0 +1,481 @@
+"""Current-plan admission and views for the manual RoboCasa evaluation launcher."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import os
+import stat
+import subprocess
+import threading
+import time
+import uuid
+from pathlib import Path
+
+from robocasa_episode_resume.model_identity import build_model_identity, verify_model_observation
+from robocasa_episode_resume.plan import build_plan, build_report, render_plan, source_key
+from robocasa_resume_execution import execute_planned_batches
+from robocasa_resume_store import RunStore
+
+
+def _protocol(args, gpus):
+    return {
+        "seed": args.seed,
+        "R": args.action_horizon,
+        "H_pred": 16,
+        "server_action_chunk_size": 16,
+        "raw_action_dim": 15,
+        "max_action_dim": 64,
+        "policy_seed": 0,
+        "num_steps": args.num_steps,
+        "guidance": args.guidance,
+        "trials": args.num_test_episodes,
+        "fps": 20,
+        "camera_set": "left_wrist",
+        "use_state": True,
+        "base_encoding": "raw",
+        "local_memory_mode": "required",
+        "image_size": 256,
+        "cam_size": 256,
+        "success_latch": 1,
+        "manual_schema": "psm_wma_robocasa_eval_v1",
+        "gpu_ids": gpus,
+        "slots_per_gpu": 1,
+        "base_port": args.base_port,
+        "server_python": str(args.server_python),
+        "save_rollout_mp4": args.save_rollout_mp4,
+        "save_generated_video": args.save_generated_video,
+        "save_init_png": args.save_init_png,
+        "save_action_jsonl": True,
+        "save_prediction_jsonl": True,
+        "server_lifecycle": args.server_lifecycle,
+        "on_infrastructure_error": args.on_infrastructure_error,
+        "timeouts": {
+            "server_start_s": args.server_start_timeout_s,
+            "predict_request_s": args.predict_request_timeout_s,
+            "episode_wall_s": args.episode_wall_timeout_s,
+            "task_wall_s": args.task_wall_timeout_s,
+            "terminate_grace_s": args.terminate_grace_s,
+        },
+    }
+
+
+def _media(args):
+    return {name: getattr(args, name) for name in ("save_rollout_mp4", "save_generated_video", "save_init_png")}
+
+
+def _provenance(manifest):
+    identity = manifest["identity"]
+    return {
+        "source_root": identity["root_sha"],
+        "source_child": identity["child_sha"],
+        "runtime_digest": identity["evaluation_runtime"]["digest"],
+        "config_sha256": identity["config_sha256"],
+        "task_metadata_by_task": {row["task"]: row["env_metadata_sha256"] for row in identity["tasks"]},
+    }
+
+
+def _view_provenance(queue_api):
+    """Record the current view producer without pretending a runtime was executed."""
+    result = {"runtime_digest": None, "runtime_probed": False}
+    for name, directory in (("source_root", queue_api.ROOT), ("source_child", queue_api.CHILD)):
+        try:
+            result[name] = subprocess.check_output(
+                ["git", "-C", str(directory), "rev-parse", "HEAD"], text=True
+            ).strip()
+        except (OSError, subprocess.CalledProcessError):
+            result[name] = None
+    return result
+
+
+def _summary(
+    plan, executed, errors, *, args, checkpoint, config_file, invocation, execution_result=None, running=False
+):
+    report = build_report(plan, executed, invocation_errors=errors)
+    if running:
+        # Coverage and absence of infrastructure errors are separate facts.
+        report.update(status="RUNNING", sr=None, exit_code=None)
+    report.update(
+        checkpoint=str(checkpoint),
+        config_file=str(config_file),
+        action_horizon=args.action_horizon,
+        expected_tasks=len(plan["selected_tasks"]),
+        invocation_dir=str(invocation),
+        total_trials=report["completed"],
+        total_successes=sum(row["successes"] for row in report["tasks"].values()),
+        completed_tasks=sum(row["remaining"] == 0 for row in report["tasks"].values()),
+        task_failures=len(
+            {
+                row.get("task")
+                for row in errors
+                if row.get("task") in report["tasks"] and row.get("stage") != "not_executed"
+            }
+        ),
+        worker_errors={f"_worker_{index}": row for index, row in enumerate(errors)},
+        job_results=(execution_result or {}).get("jobs", []),
+    )
+    all_media = {"rollout_mp4s": [], "generated_mp4s": []}
+    for task, row in report["tasks"].items():
+        sources = row["episode_sources"]
+        row.update(
+            trials=row["completed"],
+            rollouts=sources,
+            source_results_files=sorted(
+                {str(Path(ref["source_ref"]["path"]).parent / "results.json") for ref in sources}
+            ),
+            error="; ".join(item["error"] for item in errors if item.get("task") == task) or None,
+        )
+        row["rollout_mp4s"], row["generated_mp4s"] = [], []
+        for source in sources:
+            available = source.get("media_coverage", {}).get("videos_view", {})
+            if available.get("rollout"):
+                paths = available["rollout"]
+                row["rollout_mp4s"].extend([paths] if isinstance(paths, str) else paths)
+            row["generated_mp4s"].extend(available.get("generated", []))
+        for kind in all_media:
+            all_media[kind].extend(row[kind])
+    report.update({kind: sorted(set(paths)) for kind, paths in all_media.items()})
+    return report
+
+
+def _unfinished_executions(jobs, completed):
+    """Count durable Episode starts, rather than every preallocated logical slot."""
+    closed = {(row["task"], row["logical_episode_index"]) for row in completed}
+    failed = []
+    for job in jobs:
+        path = job["attempt_dir"] / "episode_progress.jsonl"
+        if any(part.is_symlink() for part in (path, *path.parents)):
+            continue  # The authoritative source scanner reports this as corrupt.
+        if not path.is_file():
+            continue
+        if not stat.S_ISREG(path.stat().st_mode):
+            continue
+        physical = {row["source_episode"]: row for row in job["episodes"]}
+        started = set()
+        for line in path.read_text().splitlines():
+            try:
+                event = json.loads(line)
+            except ValueError:
+                break
+            if (
+                isinstance(event, dict)
+                and event.get("schema") == "psm_episode_progress_v1"
+                and event.get("event") == "start"
+                and event.get("evaluation_run_digest") == job["source_manifest"]["digest"]
+                and event.get("evaluation_attempt_id") == f"{job['task']}/{job['attempt_dir'].name}"
+                and type(event.get("episode")) is int
+                and event["episode"] in physical
+            ):
+                started.add(event["episode"])
+        for index in sorted(started):
+            slot = physical[index]["logical_episode_index"]
+            if (job["task"], slot) not in closed:
+                failed.append(
+                    {
+                        "task": job["task"],
+                        "logical_episode_index": slot,
+                        "effective_seed": job["seed"],
+                        "verified": False,
+                        "outcome": "runtime_error",
+                        "error": "Episode started without valid complete evidence",
+                    }
+                )
+    return failed
+
+
+def _revalidate_selected_sources(plan, final_records, errors):
+    """A reused source invalidated during execution cannot remain in the final view."""
+    current = {source_key(row): row for row in final_records}
+    mutable = {"attempt.json", "episode_progress.jsonl", "results.json", "process_cleanup.json"}
+    result = copy.deepcopy(plan)
+    for task, info in result["tasks"].items():
+        valid = []
+        for row in info["reused_sources"]:
+            fresh = current.get(source_key(row))
+            old_core = {name: value for name, value in row["source_ref"]["hashes"].items() if name not in mutable}
+            new_core = {
+                name: value
+                for name, value in (fresh or {}).get("source_ref", {}).get("hashes", {}).items()
+                if name not in mutable
+            }
+            if fresh is None or old_core != new_core:
+                errors.append(
+                    {
+                        "task": task,
+                        "stage": "final_source_verification",
+                        "error": "SOURCE_EVIDENCE_CHANGED",
+                        "source_ref": row["source_ref"],
+                    }
+                )
+            else:
+                valid.append(fresh)
+        info["reused_sources"], info["reused"] = valid, len(valid)
+    return result
+
+
+def _view_export(queue_api, output_root, source_roots):
+    """Each source retains its digest; browsing copies cannot change evaluation status."""
+    for source_root in sorted(set(map(Path, source_roots))):
+        try:
+            view = None
+            if source_root != output_root:
+                source_id = hashlib.sha256(str(source_root).encode()).hexdigest()[:16]
+                view = output_root / "videos_view" / "sources" / source_id
+            exported = queue_api.export_videos(source_root, view_dir=view)
+            print(f"video browsing export: status={exported['status']} index={exported['index_file']}", flush=True)
+        except Exception as error:
+            try:
+                print(f"video browsing export unavailable: {type(error).__name__}: {error}", flush=True)
+            except Exception:
+                pass
+
+
+def prepare_resume(args, cache, *, queue_api):
+    """Default production admission: model identity and one shared lock before writes."""
+    discovered = queue_api.discover_task_datasets(args.dataset_root.resolve(), None)
+    mapping = dict(discovered)
+    if args.list_tasks:
+        print(json.dumps({"tasks": sorted(mapping)}, ensure_ascii=False, indent=2))
+        return 0
+    if args.tasks == "all":
+        tasks = queue_api.discover_task_datasets(args.dataset_root.resolve(), args.expected_tasks)
+    else:
+        missing = sorted(set(args.tasks) - mapping.keys())
+        if missing:
+            raise ValueError(f"unknown underlying RoboCasa tasks: {missing}")
+        tasks = [(name, mapping[name]) for name in sorted(args.tasks)]
+    checkpoint, config_file = args.checkpoint_path.resolve(), args.config_file.absolute()
+    output_root, gpus = args.output_dir.absolute(), args.gpus.split(",")
+    destination = Path(os.path.abspath(output_root))
+    for protected in (checkpoint, config_file.resolve(), args.dataset_root.resolve()):
+        if destination == protected or destination.is_relative_to(protected) or protected.is_relative_to(destination):
+            raise ValueError(f"evaluation output overlaps a read-only input: {protected}")
+    model_reads = []
+
+    def read_model():
+        identity = build_model_identity(
+            checkpoint=checkpoint, num_steps=args.num_steps, action_horizon=args.action_horizon, guidance=args.guidance
+        )
+        telemetry = identity.get("checkpoint_read_telemetry", {})
+        model_reads.append(telemetry)
+        print(f"model identity read {len(model_reads)}: {json.dumps(telemetry, sort_keys=True)}", flush=True)
+        return identity
+
+    store = RunStore(output_root, current_identity_reader=read_model, resume=args.resume)
+    output_root = store.root
+    simulation_env = queue_api.launch_environment(cache)
+    invocation_id = f"{time.time_ns()}_{os.getpid()}_{uuid.uuid4().hex[:8]}"
+
+    def admitted(*, readonly):
+        history = store.discover_history(sim_python=args.sim_python, requested_media=_media(args))
+        provenance = _view_provenance(queue_api)
+
+        def make_plan():
+            return build_plan(
+                history["records"],
+                tasks=[name for name, _ in tasks],
+                requested_episodes=args.num_test_episodes,
+                requested_seed=args.seed,
+                requested_media=_media(args),
+                execution={"gpus": gpus, "base_port": args.base_port, "timeouts": _protocol(args, gpus)["timeouts"]},
+                current_provenance=provenance,
+                invocation_id=invocation_id,
+                recovery_documents=history["recovery_documents"],
+                recovery_observations=history.get("recovery_observations", ()),
+                scan_diagnostics=history["diagnostics"],
+            )
+
+        plan = make_plan()
+        bundle = None
+        if any(row["new"] for row in plan["tasks"].values()):
+            if not config_file.is_file():
+                raise ValueError(f"config file missing: {config_file}")
+            bundle = queue_api.build_verified_evaluation_identity(
+                sim_python=args.sim_python,
+                lock_path=args.vendor_lock,
+                asset_manifest=args.asset_manifest,
+                simulation_env=simulation_env,
+                root=queue_api.ROOT,
+                checkpoint=checkpoint,
+                config_file=config_file,
+                tasks=tasks,
+                protocol=_protocol(args, gpus),
+            )
+            provenance.update(_provenance(bundle["manifest"]))
+            provenance["runtime_probed"] = True
+            plan = make_plan()
+        store.current_provenance = copy.deepcopy(provenance)
+        plan["view_producer"] = copy.deepcopy(provenance)
+        plan["checkpoint_reads"] = copy.deepcopy(model_reads)
+        print(render_plan(plan), flush=True)
+        if readonly:
+            preview = {
+                "mode": "CPU_READ_ONLY_PREVIEW",
+                "resolved_config": args.resolved_config,
+                "output_dir": str(output_root),
+                "resume_plan": plan,
+                "model_identity": store.current_identity,
+                "manifest": bundle["manifest"] if bundle else None,
+                "commands": [],
+            }
+            if bundle:
+                for task, info in plan["tasks"].items():
+                    for batch in info["execution_batches"]:
+                        batch_args = copy.copy(args)
+                        batch_args.seed, batch_args.num_test_episodes = batch["effective_seed"], len(batch["episodes"])
+                        preview["commands"].append(
+                            {
+                                "task": task,
+                                "sampling_mode": info["sampling_mode"],
+                                "server": queue_api.server_argv(batch_args, checkpoint, config_file, args.base_port),
+                                "simulator": queue_api.simulator_argv(
+                                    batch_args,
+                                    mapping[task],
+                                    output_root / "_invocations" / invocation_id / "unreserved" / task / "attempt_0001",
+                                    args.base_port,
+                                    "NOT_RESERVED_DRY_RUN",
+                                    bundle["manifest"]["identity"]["evaluation_runtime"]["digest"],
+                                    [name for name, _ in tasks],
+                                ),
+                            }
+                        )
