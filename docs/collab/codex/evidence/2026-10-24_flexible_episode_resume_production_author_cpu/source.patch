+            "--sim-python",
+            sys.executable,
+            "--save-generated-video",
+            media,
+            "--no-save-rollout-mp4",
+            "--no-save-init-png",
+            "--no-progress",
+            "--server-start-timeout-s",
+            "15",
+            "--predict-request-timeout-s",
+            "5",
+            "--episode-wall-timeout-s",
+            "30",
+            "--task-wall-timeout-s",
+            "180",
+            "--terminate-grace-s",
+            "0.2",
+        ]
+        if resume:
+            command.append("--resume")
+        monkeypatch.setattr(sys, "argv", command + list(extra))
