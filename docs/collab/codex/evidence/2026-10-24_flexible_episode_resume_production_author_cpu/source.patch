+        result = execute_planned_batches(
+            args=args,
+            checkpoint=checkpoint,
+            config_file=config_file,
+            jobs=jobs,
+            gpus=gpus,
+            output_root=invocation,
+            simulation_env=simulation_env,
+            queue_api=queue_api,
+            verify_inputs=verify_inputs,
+            on_completed=publish_running,
