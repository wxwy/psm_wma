+        plan["tasks"][task] = {
+            "requested": requested_episodes,
+            "previous_completed": len(history),
+            "reused": len(selected),
+            "new": new_count,
+            "excluded": len(history) - len(selected),
+            "reused_sources": selected,
+            "excluded_sources": history[requested_episodes:],
