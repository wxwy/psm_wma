+        _same(reference.consumer_payload, segment.consumer_payload)
+        random.random()
+        np.random.rand()
+        torch.rand(())
+    assert random.getstate() == expected_rng[0]
+    actual_np = np.random.get_state()
+    assert actual_np[0] == expected_rng[1][0]
