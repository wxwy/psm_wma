+@pytest.mark.parametrize("fault", ["no_index", "hub", "revision", "sync", "videos", "episode_subset"])
+def test_unsupported_worker_constructor_does_not_fallback(pair, fault):
+    eager, index = pair
+    kwargs = dict(
