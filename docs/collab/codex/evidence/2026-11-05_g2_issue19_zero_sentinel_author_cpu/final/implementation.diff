+def test_reported_736_frames_73_74_through_export_and_spatial_verifier(tmp_path):
+    raw, flat, source = long_source(tmp_path)
+    result = cache.export_episode(
+        tmp_path / "v2",
+        source,
+        [73, 74],
+        storage="uint16_mm",
+        chunk_frames=32,
