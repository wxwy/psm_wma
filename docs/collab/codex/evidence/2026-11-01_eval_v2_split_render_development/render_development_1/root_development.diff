+def render_slots(cfg, task_count):
+    policy = rendering(cfg)
+    mapping = dict(zip(cfg["gpu_ids"], policy["gpu_ids"]))
+    return {
+        worker: mapping[gpu] if policy["backend"] == "egl" else None
+        for worker, gpu in physical_slots(cfg, task_count).items()
+    }
+
