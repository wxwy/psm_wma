+
+@pytest.mark.parametrize("nonce", [None, "", "  ", "x" * 257])
+def test_attempt_nonce_is_required_provenance_not_a_silent_seed_source(nonce):
+    with pytest.raises(ValueError, match="attempt_nonce"):
+        plan(nonce=nonce)
