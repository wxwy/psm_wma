+    with pytest.raises(ValueError, match="num_steps"):
+        locked_snapshot(
+            tmp_path,
+            expected_identity=identity,
+            current_identity_reader=lambda: next(reads),
+            snapshot_reader=lambda: pytest.fail("must not schedule"),
