+    response = Namespace(ok=True, json=lambda: {"local_memory": {"mode": "off"}})
+    monkeypatch.setattr(requests, "get", Mock(return_value=response))
+    out = tmp_path / "CloseFridge/attempt0002"
+    attempt_id = f"CloseFridge/{out.name}"
+    monkeypatch.setattr(
+        sys,
+        "argv",
+        [
+            "closed_loop_eval.py",
+            "--dataset-dir",
