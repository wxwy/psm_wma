+def options(mode="none", rollout=False, png=False):
+    return dict(
+        digest=DIGEST,
+        expected_trials=2,
+        video_mode=mode,
+        rollout_enabled=rollout,
+        init_png_enabled=png,
+        sim_python=Path(sys.executable),
+    )
