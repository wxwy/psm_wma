        cumulative_seqlen_Q: Tensor | None = None,  # [B+1]
        cumulative_seqlen_KV: Tensor | None = None,  # [B+1]
        max_seqlen_Q: int | None = None,
        max_seqlen_KV: int | None = None,
        # backend & misc parameters
