            seqlens_KV=seqlens_KV,
            cumulative_seqlen_Q=cumulative_seqlen_Q,
            cumulative_seqlen_KV=cumulative_seqlen_KV,
            max_seqlen_Q=max_seqlen_Q,
            max_seqlen_KV=max_seqlen_KV,
        )
        is_varlen = cumulative_seqlen_Q is not None
    
