+@pytest.fixture
+def budget_rig(monkeypatch):
+    obj, clock = service(monkeypatch), BudgetClock()
+    actor = SessionTransactions(
+        obj.local_memory_adapter,
+        obj._transaction_action,
+        lambda: None,
