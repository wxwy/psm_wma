+class BudgetClock:
+    def __init__(self):
+        self.now = 0.0
+
+    def __call__(self):
+        return self.now
+
+    def pause(self, amount):
+        self.now += amount
+
+
+def settled(actor):
+    with actor._changed:
+        assert actor._changed.wait_for(
+            lambda: not actor._busy and all(t.quiescent for t in actor._tickets.values()), timeout=5
+        ), actor.info()
+
