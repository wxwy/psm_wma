diff --git a/scripts/eval_robocasa_18task_queue.py b/scripts/eval_robocasa_18task_queue.py
index eec2702d..e56eaafe 100644
--- a/scripts/eval_robocasa_18task_queue.py
+++ b/scripts/eval_robocasa_18task_queue.py
@@ -341 +341 @@ def main() -> int:
-    def worker(worker_id: int, gpu: str) -> None:
+    def run_worker(worker_id: int, gpu: str) -> None:
@@ -517,0 +518,16 @@ def main() -> int:
+    def worker(worker_id: int, gpu: str) -> None:
+        # The service loop has its own failure/cleanup path. This entry boundary
+        # also covers directory/log initialization and resource-context exits.
+        try:
+            run_worker(worker_id, gpu)
+        except BaseException as exc:  # noqa: BLE001
+            stop.set()
+            with result_lock:
+                results[f"_worker_{worker_id}"] = {
+                    "worker": worker_id,
+                    "gpu": gpu,
+                    "error": f"{type(exc).__name__}: {exc}",
+                    "server_log": str(output_root / f"_worker{worker_id:02d}_gpu{gpu}" / "action_server.log"),
+                }
+            publish()
+
diff --git a/tools/v3/eval_robocasa_queue_identity_test.py b/tools/v3/eval_robocasa_queue_identity_test.py
