+
+
+def test_worker_source_and_transform_must_remain_rng_neutral(real_recipe):
+    producer, recipe = real_recipe
+    worker = recipe.build()
+    planner = ExactWindowRankPlanner(producer.catalog, rank=0, world_size=1, b_stream=1, active_ga=1)
