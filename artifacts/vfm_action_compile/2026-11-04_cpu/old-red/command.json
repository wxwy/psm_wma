    "TORCHINDUCTOR_CACHE_DIR": "/workspace/work/action-compile-evidence/old-red/cache/inductor",
    "TORCHINDUCTOR_COMPILE_THREADS": "1",
    "TRITON_CACHE_DIR": "/workspace/work/action-compile-evidence/old-red/cache/triton",
    "XDG_CACHE_HOME": "/workspace/work/action-compile-evidence/old-red/cache/xdg",
    "HF_HOME": "/workspace/work/action-compile-evidence/old-red/cache/hf",
    "MPLCONFIGDIR": "/workspace/work/action-compile-evidence/old-red/cache/mpl",
    "RUFF_CACHE_DIR": "/workspace/work/action-compile-evidence/old-red/cache/ruff"
