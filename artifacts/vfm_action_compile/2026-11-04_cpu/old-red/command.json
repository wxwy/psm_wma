{
  "cwd": "/workspace/work/psm-wma-action-compile",
  "command": [
    "/workspace/.venvs/psm-wma-cpu/bin/python",
    "-m",
    "pytest",
    "--noconftest",
    "-c",
    "/dev/null",
    "-p",
    "no:cacheprovider",
    "-o",
    "junit_family=legacy",
    "-q",
    "--basetemp",
    "/workspace/work/action-compile-evidence/old-red/pytest-temp",
    "--junitxml",
    "/workspace/work/action-compile-evidence/old-red/junit.xml",
    "cosmos-framework/cosmos_framework/model/generator/mot/action_encode_compile_test.py",
    "-k",
    "test_alternating_B1_to_B8_metadata_long_run"
